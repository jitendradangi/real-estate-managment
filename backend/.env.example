# MySQL database configuration.
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit the real `.env` file (it is excluded via .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=real_estate_db

# Optional: path to CA certificate for TLS (e.g. TiDB Cloud). Leave empty for local MySQL.
DB_SSL_CA=
